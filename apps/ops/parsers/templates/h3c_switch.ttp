<template name="h3c_switch">
    <input name="raw_text" />
    <group name="h3c_switch">
        <section name="hostname">
            <regex name="hostname">^\s*sysname\s+(.+)</regex>
        </section>
        <section name="vlans">
            <regex name="vlan"> vlan\s+(\d+)</regex>
        </section>
    </group>
</template>
